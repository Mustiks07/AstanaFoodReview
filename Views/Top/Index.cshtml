@model IEnumerable<RestaurantDTO>
@{
    ViewData["Title"] = "Топ заведений";
    var list = Model.ToList();
}

<div class="container py-4">
    <h1 class="section-title">Топ заведений Астаны</h1>

    <div class="glass-card p-2">
        @for (int i = 0; i < list.Count; i++)
        {
            var r = list[i];
            var rankClass = i == 0 ? "rank-gold" : i == 1 ? "rank-silver" : i == 2 ? "rank-bronze" : "rank-other";
            <a href="/restaurants/@r.Id" class="text-decoration-none">
                <div class="d-flex align-items-center gap-3 p-3 @(i < list.Count - 1 ? "border-bottom" : "")" style="border-color:var(--border)!important;">
                    <span class="rank-num @rankClass">@(i + 1)</span>
                    <div class="flex-grow-1">
                        <div class="fw-semibold" style="color:var(--text);">@r.Title</div>
                        <div class="text-muted small">@r.CuisineName · @r.DistrictName</div>
                    </div>
                    <div class="text-end">
                        <div class="stars">@Html.Raw(HelperDTO.StarsHtml(r.AverageRating))</div>
                        <div class="text-muted small">@r.AverageRating · @r.ReviewCount отз.</div>
                    </div>
                    @if (r.IsVerified)
                    {
                        <span class="badge-verified d-none d-md-inline">✓</span>
                    }
                </div>
            </a>
        }
        @if (!list.Any())
        {
            <div class="p-4 text-center text-muted">Нет данных</div>
        }
    </div>
</div>
