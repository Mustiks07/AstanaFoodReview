@{
    ViewData["Title"] = "Главная";
    var top3 = ViewBag.Top3 as List<RestaurantDTO> ?? [];
    var cuisines = ViewBag.Cuisines as IEnumerable<Cuisine> ?? [];
}

<!-- Hero -->
<section class="hero">
    <div class="container">
        <div class="mb-3" style="font-size:3rem;">🍽</div>
        <h1 class="hero-title">Astana <span>Food</span> Reviews</h1>
        <p class="hero-sub">@L.T("home.subtitle")</p>
        <div class="d-flex gap-3 justify-content-center mt-4 flex-wrap">
            <a asp-controller="Restaurants" asp-action="Index" class="btn btn-brand">@L.T("home.find")</a>
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-brand">@L.T("home.write_review")</a>
            }
        </div>
    </div>
</section>

<div class="container py-5">

    <!-- Stats -->
    <div class="row g-3 mb-5 justify-content-center">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-value">@ViewBag.RestaurantCount</div>
                <div class="stat-label">@L.T("home.stat_rest")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-value">@ViewBag.ReviewCount</div>
                <div class="stat-label">@L.T("home.stat_rev")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-value" style="font-size:1.8rem;">@ViewBag.AverageRating ★</div>
                <div class="stat-label">@L.T("home.stat_avg")</div>
            </div>
        </div>
    </div>

    <!-- Top 3 -->
    @if (top3.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="section-title mb-0">@L.T("home.best")</h2>
            <a asp-controller="Top" asp-action="Index" class="btn btn-ghost btn-sm">@L.T("home.all_rating")</a>
        </div>
        <div class="row g-3 mb-5">
            @foreach (var r in top3)
            {
                <div class="col-md-4">
                    <a href="/Restaurants/Show/@r.Id" class="text-decoration-none">
                        <div class="rest-card">
                            @if (!string.IsNullOrEmpty(r.ImageUrl))
                            {
                                <img src="@r.ImageUrl" class="rest-card-img" alt="@r.Title" />
                            }
                            else
                            {
                                <div class="rest-card-img-placeholder">🍽</div>
                            }
                            <div class="rest-card-body">
                                <div class="rest-title">@r.Title</div>
                                <div class="rest-meta">@r.CuisineName · @r.DistrictName</div>
                                @if (!string.IsNullOrEmpty(r.Address))
                                {
                                    <div class="rest-meta" style="font-size:.75rem;">📍 @r.Address</div>
                                }
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span class="badge-price">@r.PriceRangeLabel</span>
                                    @if (r.IsVerified){ <span class="badge-verified">@L.T("rest.verified")</span> }
                                </div>
                                <div class="rest-footer d-flex align-items-center gap-2">
                                    <span class="stars">@Html.Raw(HelperDTO.StarsHtml(r.AverageRating))</span>
                                    <span style="color:var(--text-muted);font-size:.82rem;">@r.AverageRating · @r.ReviewCount @L.T("rest.reviews_sfx")</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <!-- Cuisines -->
    <h2 class="section-title">@L.T("home.by_cuisine")</h2>
    <div class="d-flex flex-wrap gap-2 mb-5">
        @foreach (var c in cuisines)
        {
            <a href="/Restaurants/Index?cuisineId=@c.Id" class="cuisine-pill">@c.Title</a>
        }
    </div>

    <!-- CTA -->
    @if (!User.Identity!.IsAuthenticated)
    {
        <div class="card-base p-4 p-md-5 text-center" style="background:linear-gradient(135deg,#FFF7ED,#FFFBF5);">
            <div style="font-size:2.5rem;margin-bottom:.75rem;">✍️</div>
            <h4 class="brand-font mb-2" style="color:var(--text);">@L.T("home.been_there")</h4>
            <p style="color:var(--text-muted);" class="mb-3">@L.T("home.cta_body")</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-brand">@L.T("home.write_review")</a>
        </div>
    }
</div>
