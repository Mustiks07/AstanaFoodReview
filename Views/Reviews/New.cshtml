@model CreateReviewViewModel
@{
    ViewData["Title"] = L.T("rev.page_title");
    string restaurantName = ViewBag.RestaurantName ?? "";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h1 class="section-title">@L.T("rev.heading") «@restaurantName»</h1>
            <div class="glass-card p-4">
                <form action="/reviews/new" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RestaurantId" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">@L.T("rev.title_label")</label>
                        <input asp-for="Title" class="form-control" placeholder="@L.T("rev.title_ph")" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Text" class="form-label">@L.T("rev.text_label")</label>
                        <textarea asp-for="Text" class="form-control" rows="4" placeholder="@L.T("rev.text_ph")"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L.T("rev.rating")</label>
                        <div class="star-input">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" id="Rating-@i" name="Rating" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="Rating-@i">★</label>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L.T("show.food") *</label>
                        <div class="star-input">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" id="FoodRating-@i" name="FoodRating" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="FoodRating-@i">★</label>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L.T("show.service") *</label>
                        <div class="star-input">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" id="ServiceRating-@i" name="ServiceRating" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="ServiceRating-@i">★</label>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L.T("show.price_q") *</label>
                        <div class="star-input">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" id="PriceRating-@i" name="PriceRating" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="PriceRating-@i">★</label>
                            }
                        </div>
                    </div>

                    <button type="submit" class="btn btn-brand w-100 mt-2">@L.T("rev.submit")</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
