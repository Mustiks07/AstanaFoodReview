<!DOCTYPE html>
<html lang="@L.Lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")Astana Food Reviews</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🍽 Astana Food</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Restaurants" asp-action="Index">@L.T("nav.restaurants")</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Top" asp-action="Index">@L.T("nav.top")</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Map" asp-action="Index">@L.T("nav.map")</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">@L.T("nav.about")</a></li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <!-- Language switcher -->
                    <li class="nav-item d-flex gap-1">
                        <a href="/lang/ru?returnUrl=@Context.Request.Path" class="lang-btn @(L.Lang == "ru" ? "active" : "")">РУ</a>
                        <a href="/lang/kz?returnUrl=@Context.Request.Path" class="lang-btn @(L.Lang == "kz" ? "active" : "")">ҚЗ</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">@L.T("nav.profile")</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/admin">@L.T("nav.admin")</a></li>
                        }
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-ghost btn-sm">@L.T("nav.logout")</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">@L.T("nav.login")</a></li>
                        <li class="nav-item"><a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Register">@L.T("nav.register")</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <span>© 2026 Astana Food Reviews — @(L.Lang == "kz" ? "Астана мейрамханалары туралы пікірлер" : "отзывы о ресторанах Астаны")</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
