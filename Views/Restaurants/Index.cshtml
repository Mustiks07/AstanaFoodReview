@model IEnumerable<RestaurantDTO>
@{
    ViewData["Title"] = "Заведения";
    var districts = ViewBag.Districts as IEnumerable<District> ?? [];
    var cuisines  = ViewBag.Cuisines  as IEnumerable<Cuisine>  ?? [];
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="section-title mb-0">Заведения Астаны</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="New" class="btn btn-brand btn-sm">+ Добавить</a>
        }
    </div>

    <!-- Filters -->
    <div class="filter-bar mb-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Поиск по названию..." value="@ViewBag.Search" />
            </div>
            <div class="col-6 col-md-2">
                <select name="districtId" class="form-select form-select-sm">
                    <option value="">Все районы</option>
                    @foreach (var d in districts)
                    {
                        <option value="@d.Id" selected="@(ViewBag.DistrictId == d.Id)">@d.Title</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="cuisineId" class="form-select form-select-sm">
                    <option value="">Все кухни</option>
                    @foreach (var c in cuisines)
                    {
                        <option value="@c.Id" selected="@(ViewBag.CuisineId == c.Id)">@c.Title</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="priceRange" class="form-select form-select-sm">
                    <option value="">Любая цена</option>
                    <option value="0" selected="@(ViewBag.PriceRange?.ToString() == "Budget")">до 2000 ₸</option>
                    <option value="1" selected="@(ViewBag.PriceRange?.ToString() == "Medium")">2000–5000 ₸</option>
                    <option value="2" selected="@(ViewBag.PriceRange?.ToString() == "Premium")">5000–15000 ₸</option>
                    <option value="3" selected="@(ViewBag.PriceRange?.ToString() == "Luxury")">от 15000 ₸</option>
                </select>
            </div>
            <div class="col-6 col-md-1">
                <select name="sort" class="form-select form-select-sm">
                    <option value="" selected="@(ViewBag.Sort == null)">Новые</option>
                    <option value="rating" selected="@(ViewBag.Sort == "rating")">Рейтинг</option>
                    <option value="reviews" selected="@(ViewBag.Sort == "reviews")">Отзывы</option>
                </select>
            </div>
            <div class="col-12 col-md-1">
                <button type="submit" class="btn btn-brand btn-sm w-100">Найти</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">Заведения не найдены</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a href="/Restaurants/Show/@r.Id" class="text-decoration-none d-block h-100">
                        <div class="rest-card h-100">
                            @if (!string.IsNullOrEmpty(r.ImageUrl))
                            {
                                <img src="@r.ImageUrl" class="rest-card-img" alt="@r.Title" />
                            }
                            else
                            {
                                <div class="rest-card-img-placeholder">🍽</div>
                            }
                            <div class="rest-card-body">
                                <div class="rest-title">@r.Title</div>
                                <div class="rest-meta">
                                    @r.CuisineName · @r.DistrictName<br />
                                    @if (!string.IsNullOrEmpty(r.Address))
                                    {
                                        <span>@r.Address</span>
                                    }
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span class="badge-price">@r.PriceRangeLabel</span>
                                    @if (r.IsVerified)
                                    {
                                        <span class="badge-verified">✓ Верифицировано</span>
                                    }
                                </div>
                                <div class="rest-footer d-flex align-items-center gap-2">
                                    <span class="stars">@Html.Raw(HelperDTO.StarsHtml(r.AverageRating))</span>
                                    <span class="text-muted small">@r.AverageRating</span>
                                    <span class="text-muted small ms-auto">@r.ReviewCount отз.</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
