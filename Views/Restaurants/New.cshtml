@model CreateRestaurantViewModel
@{
    ViewData["Title"] = "Добавить заведение";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h1 class="section-title">Добавить заведение</h1>
            <div class="glass-card p-4">
                <form asp-action="New" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Название *</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Адрес *</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Телефон</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label">Сайт</label>
                            <input asp-for="Website" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label">URL фотографии</label>
                        <input asp-for="ImageUrl" class="form-control" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="DistrictId" class="form-label">Район *</label>
                            <select asp-for="DistrictId" class="form-select">
                                <option value="">Выберите район</option>
                                @foreach (var d in Model.Districts)
                                {
                                    <option value="@d.Id">@d.Title</option>
                                }
                            </select>
                            <span asp-validation-for="DistrictId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CuisineId" class="form-label">Кухня *</label>
                            <select asp-for="CuisineId" class="form-select">
                                <option value="">Выберите кухню</option>
                                @foreach (var c in Model.Cuisines)
                                {
                                    <option value="@c.Id">@c.Title</option>
                                }
                            </select>
                            <span asp-validation-for="CuisineId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PriceRange" class="form-label">Ценовой диапазон</label>
                            <select asp-for="PriceRange" class="form-select">
                                <option value="0">до 2000 ₸</option>
                                <option value="1" selected>2000–5000 ₸</option>
                                <option value="2">5000–15000 ₸</option>
                                <option value="3">от 15000 ₸</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-brand w-100">Добавить заведение</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
