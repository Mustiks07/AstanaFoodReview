@model District
@{
    ViewData["Title"] = Model.Id == 0 ? "Новый район" : "Редактировать район";
    Layout = "_AdminLayout";
}

<h1 class="section-title">@ViewData["Title"]</h1>
<div class="glass-card p-4" style="max-width:400px;">
    <form action="/admin/districts/edit/@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Название</label>
            <input name="title" class="form-control" value="@Model.Title" required />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-brand">Сохранить</button>
            <a href="/admin/districts" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
</div>
