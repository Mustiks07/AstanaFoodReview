@model IEnumerable<RestaurantDTO>
@{
    ViewData["Title"] = "Заведения";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="section-title mb-0">Заведения</h1>
</div>

<div class="glass-card p-0" style="overflow:auto;">
    <table class="admin-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Название</th>
                <th>Кухня</th>
                <th>Район</th>
                <th>Рейтинг</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.Title</td>
                    <td>@r.CuisineName</td>
                    <td>@r.DistrictName</td>
                    <td><span class="stars">@Html.Raw(HelperDTO.StarsHtml(r.AverageRating))</span> @r.AverageRating</td>
                    <td>
                        @if (r.IsVerified)
                        {
                            <span class="badge-verified">✓ Верифицировано</span>
                        }
                        else
                        {
                            <span class="text-muted small">Не верифицировано</span>
                        }
                    </td>
                    <td>
                        <a href="/admin/restaurants/edit/@r.Id" class="btn-ghost btn-sm me-1">Изменить</a>
                        <form action="/admin/restaurants/delete/@r.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-ghost btn-sm" onclick="return confirm('Удалить?')">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
