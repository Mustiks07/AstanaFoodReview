@model LoginViewModel
@{
    Layout = null; // Completely separate from public layout
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Панель администратора</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #0f172a; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; }
        .admin-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }
        .admin-logo { color: #F97316; font-size: 2rem; text-align: center; margin-bottom: .5rem; }
        .admin-title { color: #f1f5f9; font-size: 1.1rem; font-weight: 600; text-align: center; margin-bottom: .25rem; }
        .admin-sub { color: #64748b; font-size: .8rem; text-align: center; margin-bottom: 2rem; }
        .form-label { color: #94a3b8; font-size: .8rem; margin-bottom: .3rem; }
        .form-control {
            background: #0f172a !important;
            border: 1px solid #334155 !important;
            color: #f1f5f9 !important;
            border-radius: 8px;
        }
        .form-control:focus { border-color: #F97316 !important; box-shadow: 0 0 0 3px rgba(249,115,22,0.2) !important; }
        .form-control::placeholder { color: #475569; }
        .btn-admin {
            background: #F97316; color: #fff; border: none; border-radius: 8px;
            padding: .65rem; font-weight: 600; width: 100%; font-size: .9rem;
            transition: background .2s;
        }
        .btn-admin:hover { background: #ea6c0a; color: #fff; }
        .alert-danger { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; border-radius: 8px; font-size: .85rem; }
        .back-link { color: #475569; font-size: .78rem; text-align: center; margin-top: 1.25rem; display: block; }
        .back-link:hover { color: #94a3b8; }
    </style>
</head>
<body>
    <div class="admin-card">
        <div class="admin-logo">⚙</div>
        <div class="admin-title">Astana Food Admin</div>
        <div class="admin-sub">Панель управления</div>

        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="alert-danger p-2 mb-3">@error.ErrorMessage</div>
            }
        }

        <form action="/admin/login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="mb-3">
                <label class="form-label">Логин</label>
                <input type="text" name="UserName" class="form-control" autocomplete="username" autofocus />
            </div>
            <div class="mb-4">
                <label class="form-label">Пароль</label>
                <input type="password" name="Password" class="form-control" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn-admin">Войти</button>
        </form>

        <a href="/" class="back-link">← На сайт</a>
    </div>
</body>
</html>
