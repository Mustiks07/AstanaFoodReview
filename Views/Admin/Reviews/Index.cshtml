@model IEnumerable<ReviewDTO>
@{
    ViewData["Title"] = "Отзывы";
    Layout = "_AdminLayout";
}

<h1 class="section-title">Отзывы</h1>

@foreach (var r in Model)
{
    <div class="glass-card review-card mb-3">
        <div class="review-header">
            <div>
                <a href="/restaurants/@r.RestaurantId" class="fw-semibold">@r.RestaurantName</a>
                <span class="text-muted small ms-2">by @(r.AuthorName ?? "Аноним")</span>
                <span class="text-muted small ms-2">@r.DateCreated.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="stars">@Html.Raw(HelperDTO.StarsHtml(r.Rating))</div>
        </div>
        <div class="review-title mt-1">@r.Title</div>
        @if (!string.IsNullOrEmpty(r.Text))
        {
            <div class="review-text">@r.Text</div>
        }

        <div class="d-flex gap-2 mt-3 flex-wrap align-items-end">
            <!-- Respond form -->
            <form action="/admin/reviews/respond/@r.Id" method="post" class="d-flex gap-2 flex-grow-1">
                @Html.AntiForgeryToken()
                <input name="text" class="form-control form-control-sm" placeholder="Ответ от заведения..." />
                <button type="submit" class="btn btn-brand btn-sm">Ответить</button>
            </form>
            <!-- Delete -->
            <form action="/admin/reviews/delete/@r.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-ghost btn-sm" onclick="return confirm('Удалить отзыв?')">Удалить</button>
            </form>
        </div>

        @foreach (var resp in r.OwnerResponses)
        {
            <div class="owner-response mt-2">
                <div class="owner-response-label">Ответ от @resp.AdminName · @resp.DateCreated.ToString("dd.MM.yyyy")</div>
                <div class="text-muted small">@resp.Text</div>
            </div>
        }
    </div>
}

@if (!Model.Any())
{
    <div class="glass-card p-4 text-center text-muted">Отзывов нет</div>
}
