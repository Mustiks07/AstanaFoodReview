@using AstanaFoodReviews.Domain.Entities
@using AstanaFoodReviews.Infrastructure
@model IEnumerable<District>
@{
    ViewData["Title"] = L.T("map.title");
    var districts   = Model.ToList();
    var restaurants = ViewBag.Restaurants as IEnumerable<Restaurant> ?? [];
    var reviewedIds = ViewBag.ReviewedIds as HashSet<int> ?? [];
}

<div class="container py-4">
    <h1 class="section-title">@L.T("map.title")</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex gap-3 mb-3 align-items-center" style="font-size:.85rem;">
            <span><span style="display:inline-block;width:14px;height:14px;background:#22c55e;border-radius:50%;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.2);vertical-align:middle;"></span> &nbsp;Оставил отзыв</span>
            <span><span style="display:inline-block;width:14px;height:14px;background:#F97316;border-radius:50%;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.2);vertical-align:middle;"></span> &nbsp;Ещё не посетил</span>
        </div>
    }

    <div id="map" class="mb-4"></div>

    <div class="row g-3">
        @foreach (var d in districts)
        {
            <div class="col-6 col-md-3">
                <a href="/Restaurants/Index?districtId=@d.Id" class="text-decoration-none">
                    <div class="glass-card p-3 text-center">
                        <div class="fw-semibold" style="color:var(--text);">@d.Title</div>
                        <div class="text-muted small">@d.Restaurants.Count @L.T("map.sfx")</div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
    .map-pin { display:flex; flex-direction:column; align-items:center; }
    .map-pin-bubble {
        width:38px; height:38px; border-radius:50%;
        display:flex; align-items:center; justify-content:center;
        font-size:1.1rem; border:3px solid #fff;
        box-shadow:0 3px 10px rgba(0,0,0,0.25);
        transition:transform .15s;
    }
    .map-pin-bubble:hover { transform:scale(1.15); }
    .map-pin-bubble.reviewed  { background:#22c55e; }
    .map-pin-bubble.default   { background:#F97316; }
    .map-pin-tail { width:3px; height:8px; border-radius:0 0 3px 3px; }
    .map-pin-tail.reviewed    { background:#22c55e; }
    .map-pin-tail.default     { background:#F97316; }

    .leaflet-popup-content-wrapper {
        border-radius:12px !important;
        box-shadow:0 8px 24px rgba(0,0,0,0.12) !important;
        border:1px solid var(--border) !important;
    }
    .leaflet-popup-content { margin:12px 16px !important; font-family:'Inter',sans-serif; min-width:180px; }
    .popup-title   { font-weight:700; font-size:.9rem; color:var(--text); margin-bottom:3px; }
    .popup-meta    { font-size:.78rem; color:var(--text-muted); margin-bottom:6px; }
    .popup-reviewed { font-size:.75rem; color:#16a34a; font-weight:600; margin-bottom:6px; }
    .popup-link {
        display:inline-block; background:var(--brand); color:#fff !important;
        border-radius:8px; padding:4px 12px; font-size:.8rem; font-weight:600;
        text-decoration:none !important;
    }
    .popup-link:hover { background:var(--brand-dark); }
</style>
<script>
    var map = L.map('map').setView([51.18, 71.45], 12);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> © <a href="https://carto.com/">CARTO</a>',
        maxZoom: 18
    }).addTo(map);

    // Координаты районов
    var districtCoords = {
        "Есіл":     [51.175, 71.42],
        "Алматы":   [51.15,  71.47],
        "Сарыарқа": [51.19,  71.50],
        "Нұра":     [51.22,  71.40],
        "Байқоңыр": [51.12,  71.38],
        "Жетісу":   [51.14,  71.54],
        "Алатау":   [51.20,  71.33],
        "Байтерек": [51.18,  71.44]
    };

    var restaurants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        restaurants.Select(r => new {
            id       = r.Id,
            title    = r.Title,
            district = r.District?.Title ?? "",
            cuisine  = r.Cuisine?.Title ?? "",
            address  = r.Address ?? "",
            rating   = r.Reviews.Any()
                ? Math.Round(r.Reviews.Average(rv => rv.Rating), 1)
                : 0.0,
            reviewed = reviewedIds.Contains(r.Id)
        })
    ));

    var isAuth = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
    var reviewedLabel = "@(L.Lang == "kz" ? "Пікір қалдырдым" : "Вы оставили отзыв")";
    var viewLabel     = "@(L.Lang == "kz" ? "Қарау →" : "Смотреть →")";

    // Небольшой детерминированный сдвиг чтобы маркеры не накладывались
    function offset(id, index, total) {
        var angle  = (2 * Math.PI / Math.max(total, 1)) * index;
        var radius = total > 1 ? 0.008 : 0;
        return [Math.sin(angle) * radius, Math.cos(angle) * radius];
    }

    // Группируем по районам для расчёта офсетов
    var byDistrict = {};
    restaurants.forEach(function(r) {
        if (!byDistrict[r.district]) byDistrict[r.district] = [];
        byDistrict[r.district].push(r);
    });

    Object.keys(byDistrict).forEach(function(distName) {
        var base = districtCoords[distName];
        if (!base) return;
        var group = byDistrict[distName];
        group.forEach(function(r, i) {
            var off  = offset(r.id, i, group.length);
            var ll   = [base[0] + off[0], base[1] + off[1]];
            var cls  = r.reviewed ? 'reviewed' : 'default';

            var icon = L.divIcon({
                className: '',
                html: '<div class="map-pin">' +
                          '<div class="map-pin-bubble ' + cls + '">🍽</div>' +
                          '<div class="map-pin-tail '  + cls + '"></div>' +
                      '</div>',
                iconSize:    [38, 48],
                iconAnchor:  [19, 48],
                popupAnchor: [0, -52]
            });

            var stars = '';
            if (r.rating > 0) {
                for (var s = 1; s <= 5; s++)
                    stars += s <= Math.round(r.rating) ? '★' : '☆';
                stars = '<span style="color:#F97316;font-size:.85rem;">' + stars + '</span> ' +
                        '<span style="font-size:.78rem;color:#64748b;">' + r.rating + '</span>';
            }

            var reviewedBadge = (isAuth && r.reviewed)
                ? '<div class="popup-reviewed">✓ ' + reviewedLabel + '</div>'
                : '';

            var popup =
                '<div class="popup-title">'  + r.title   + '</div>' +
                '<div class="popup-meta">'   + r.cuisine + ' · ' + r.district + (r.address ? '<br>📍 ' + r.address : '') + '</div>' +
                (stars ? '<div style="margin-bottom:6px;">' + stars + '</div>' : '') +
                reviewedBadge +
                '<a class="popup-link" href="/Restaurants/Show/' + r.id + '">' + viewLabel + '</a>';

            L.marker(ll, { icon: icon }).bindPopup(popup).addTo(map);
        });
    });
</script>
}
